{
  "openapi": "3.0.1",
  "info": {
    "title": "CureWellHospital",
    "version": "1.0"
  },
  "paths": {
    "/api/Surgery/AddSurgeryDetails": {
      "post": {
        "tags": [
          "Surgery"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Surgery/UpdateSurgeryTime": {
      "put": {
        "tags": [
          "Surgery"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Surgery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Surgery": {
        "required": [
          "doctorId",
          "endTime",
          "startTime",
          "surgeryCategory",
          "surgeryDate",
          "surgeryId"
        ],
        "type": "object",
        "properties": {
          "surgeryId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "surgeryDate": {
            "type": "string",
            "format": "date-time"
          },
          "startTime": {
            "maximum": 24,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "endTime": {
            "maximum": 24,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "surgeryCategory": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}